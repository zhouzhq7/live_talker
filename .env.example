# Live Talker - API Key 配置示例
# 复制此文件为 .env 并填入你的 API Key

# ================================
# 智谱 AI (GLM-4-Flash 完全免费) ⭐ 推荐
# 申请: https://open.bigmodel.cn
# ================================
ZHIPU_API_KEY=your_zhipu_api_key_here
# ZHIPU_MODEL=glm-4-flash  # 免费选项: glm-4-flash, glm-4-air, glm-4

# ================================
# DeepSeek (价格低，中文强) ⭐ 推荐
# 申请: https://platform.deepseek.com (送¥10)
# ================================
DEEPSEEK_API_KEY=sk-your_deepseek_key_here
# DEEPSEEK_MODEL=deepseek-chat  # 选项: deepseek-chat, deepseek-coder

# ================================
# OpenAI (国际稳定，需要海外支付)
# 申请: https://platform.openai.com
# ================================
# OPENAI_API_KEY=sk-your_openai_key_here
# OPENAI_MODEL=gpt-4o-mini  # 选项: gpt-4o-mini, gpt-4o, gpt-3.5-turbo

# ================================
# Moonshot / Kimi (超长上下文)
# 申请: https://platform.moonshot.cn (送¥15)
# ================================
# MOONSHOT_API_KEY=your_moonshot_key_here
# MOONSHOT_MODEL=moonshot-v1-8k  # 选项: moonshot-v1-8k, 32k, 128k

# ================================
# LLM 配置
# ================================
# LLM_PROVIDER=deepseek  # 主Provider
# LLM_ENABLE_FALLBACK=true  # 启用故障转移
